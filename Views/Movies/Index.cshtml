@model IEnumerable<MoviesAnalysis.Models.Movie>

@{
    ViewData["Title"] = "My Movies";
}

<h2>@ViewData["Title"]</h2>

<div class="mb-3">
    <a class="btn btn-primary" href="/Movies/GetFromTMDB">Take Data from TMDB</a>
    <a class="btn btn-success" href="/Movies/Create">Add Movie</a>
    <a class="btn btn-warning" href="/Movies/DeleteAll" onclick="return confirm('Are you sure you want to delete ALL movies?')">Delete All Movies</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Release Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.ReleaseDate</td>
                <td>
                    <a class="btn btn-danger btn-sm" href="/Movies/DeleteById?id=@movie.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>